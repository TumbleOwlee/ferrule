$ run next ns gate4 status=ready file=.claude/tasks/artifacts/ns/pr.md follow-ups=1
next=stop
run: ferrule prompt render ns gate4
do: show the gate 4 stop and wait for the user's approval
guide: ferrule guide gate4 --slug ns
exit=0
$ run next ns gate4 status=question file=.claude/tasks/artifacts/ns/question.md count=1
next=relay
do: relay the question file to the user and resume the agent with the answers
guide: ferrule guide question --slug ns
exit=0
$ run next ns ci ci=1
logged: ci=1
next=fix
run: ferrule pr failed feat/ns
do: read the failed workflow and fix it
guide: ferrule guide gate4 --slug ns
exit=0
$ run next ns ci ci=0
logged: ci=0
next=done
run: ferrule run cleanup ns
do: clean up the run
guide: ferrule guide cleanup --slug ns
exit=0
log:
2026-10-05T09:00 ci=1
2026-10-05T09:00 ci=0
exit=0
